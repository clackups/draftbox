{
  "name": "draftbox",
  "version": "0.1.0",
  "description": "Git hosting for non-technical users",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "check-ascii": "node scripts/check-ascii.ts"
  },
  "allowScripts": {
    "nodegit": true
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "marked": "^18.0.14",
    "nodegit": "^0.27.0",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodegit": "^0.28.11",
    "typescript": "^7.0.2"
  }
}
